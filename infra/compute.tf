# Pinned to the AMI actually running in production. Bump deliberately (not via
# "most recent" lookups) so applies never silently swap the base image.
locals {
  ami_id = "ami-0d1aebc9947ba5670" # ubuntu-jammy-22.04-amd64-server-20260714
}

# The key pair was generated by AWS at deploy time (create-key-pair), so AWS
# never has the public key material to compare against — referenced read-only
# here rather than as a managed resource to avoid a perpetual replace diff.
data "aws_key_pair" "this" {
  key_name = "academic-paper-assistant"
}

resource "aws_instance" "this" {
  ami                    = local.ami_id
  instance_type          = var.instance_type
  subnet_id              = aws_subnet.this.id
  vpc_security_group_ids = [aws_security_group.this.id]
  key_name               = data.aws_key_pair.this.key_name
  iam_instance_profile   = aws_iam_instance_profile.ssm.name
  user_data              = file("${path.module}/user-data.sh")

  # user_data only runs on first boot; don't replace a running instance just
  # because this file's formatting shifted.
  user_data_replace_on_change = false

  root_block_device {
    volume_size = var.root_volume_size
    volume_type = "gp3"
  }

  tags = {
    Name = "academic-paper-assistant"
  }
}

output "instance_public_ip" {
  value = aws_instance.this.public_ip
}

output "instance_id" {
  value = aws_instance.this.id
}
